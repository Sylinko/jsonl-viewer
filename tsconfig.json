{
  "extends": "./tsconfig.strict.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.ts", "cloudflare.config.ts"]
}
